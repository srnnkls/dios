#!/usr/bin/env bash
#MISE description="Alternate baseline and candidate frame_write_path binaries into a paired samples CSV"
#USAGE arg "<base_dir>"
#USAGE arg "<candidate_dir>"
#USAGE arg "<case>"
#USAGE arg "<reps>"
#USAGE arg "<csv>"
set -euo pipefail

bench_binary() {
  local built
  built=$(cd "$1" && cargo bench --features bench,mock --bench frame_write_path --no-run 2>&1 \
    | sed -n 's/.*Executable .*(\(.*\)).*/\1/p' | tail -1)
  [ -n "$built" ] || { echo "no frame_write_path binary under $1" >&2; exit 1; }
  echo "$1/$built"
}

base=$(bench_binary "$usage_base_dir")
candidate=$(bench_binary "$usage_candidate_dir")
mkdir -p "$(dirname "$usage_csv")"
echo "base_ns,candidate_ns" > "$usage_csv"
for ((rep = 0; rep < usage_reps; rep++)); do
  if ((rep % 2 == 0)); then
    base_ns=$(taskset -c 2 "$base" "$usage_case")
    candidate_ns=$(taskset -c 2 "$candidate" "$usage_case")
  else
    candidate_ns=$(taskset -c 2 "$candidate" "$usage_case")
    base_ns=$(taskset -c 2 "$base" "$usage_case")
  fi
  echo "$base_ns,$candidate_ns" >> "$usage_csv"
done
sha256sum "$base" "$candidate" "$usage_csv"
