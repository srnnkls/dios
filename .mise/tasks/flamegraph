#!/usr/bin/env bash
#MISE description="Profile a bench/example/bin: folded stacks + top-N self-time table + SVG"
#MISE tools={"cargo:inferno"="0.12.7","cargo:rustfilt"="0.2.1","jq"="latest"}
set -euo pipefail

usage() {
  echo "usage: mise run flamegraph <cargo target args> [-- <run args>]"
  echo "  mise run flamegraph --bench smoke -- --bench --profile-time 10"
  echo "  mise run flamegraph --example replay"
  echo "  mise run flamegraph --bin dios"
  exit 2
}
[ $# -ge 1 ] || usage

build_args=()
run_args=()
seen_separator=0
original_cwd=$PWD
build_cwd=$original_cwd
manifest_path_next=0
for arg in "$@"; do
  if [ "$seen_separator" = 1 ]; then
    run_args+=("$arg")
  elif [ "$manifest_path_next" = 1 ]; then
    if [[ "$arg" = /* ]]; then
      manifest_path="$arg"
    else
      manifest_path="$original_cwd/$arg"
    fi
    build_cwd=$(cd -- "$(dirname -- "$manifest_path")" && pwd -P)
    build_args+=("$build_cwd/$(basename -- "$manifest_path")")
    manifest_path_next=0
  elif [ "$arg" = "--" ]; then
    seen_separator=1
  else
    build_args+=("$arg")
    if [ "$arg" = "--manifest-path" ]; then
      manifest_path_next=1
    fi
  fi
done

out_dir=${DIOS_PROFILE_OUTPUT:-target/flamegraph}
mkdir -p "$out_dir"

binary=${DIOS_PROFILE_BINARY:-}
if [ -z "$binary" ]; then
  binary=$(
    (cd "$build_cwd" && cargo build --profile profiling --features bench --message-format=json "${build_args[@]}") |
      jq -r 'select(.reason == "compiler-artifact") | select(.executable != null) | .executable' |
      tail -1
  )
fi
[ -n "$binary" ] || { echo "no executable produced for: ${build_args[*]}"; exit 1; }
[ -x "$binary" ] || { echo "profile binary is not executable: $binary"; exit 1; }

run_command=("$binary")
if [ "${#run_args[@]}" -gt 0 ]; then
  run_command+=("${run_args[@]}")
fi

if [ "$(uname)" = "Darwin" ]; then
  "${run_command[@]}" &
  target_pid=$!
  /usr/bin/sample "$target_pid" 3600 1 -mayDie -f "$out_dir/sample.txt" >/dev/null
  wait "$target_pid"
  inferno-collapse-sample "$out_dir/sample.txt" | rustfilt >"$out_dir/profile.folded"
else
  event=${DIOS_PROFILE_EVENT:-cpu-clock}
  case "$event" in
    cpu-clock) sampling=(-e cpu-clock -F 997) ;;
    cycles) sampling=(-e cycles -c 100000) ;;
    *) echo "unsupported profile event: $event" >&2; exit 2 ;;
  esac
  mapping_pages=${DIOS_PROFILE_MMAP_PAGES:-16}
  case "$mapping_pages" in
    16|32|64|128) mapping=(-m "$mapping_pages") ;;
    *) echo "unsupported profile mmap page count: $mapping_pages" >&2; exit 2 ;;
  esac
  if [ -n "${DIOS_PROFILE_CPUS:-}" ]; then
    run_command=(taskset -c "$DIOS_PROFILE_CPUS" "${run_command[@]}")
  fi
  perf record -o "$out_dir/perf.data" "${sampling[@]}" \
    --call-graph dwarf,16384 "${mapping[@]}" \
    -- "${run_command[@]}"
  perf report -i "$out_dir/perf.data" --header-only >"$out_dir/perf-header.txt"
  perf report -i "$out_dir/perf.data" --stdio --stats >"$out_dir/perf-statistics.txt"
  if rg -q 'LOST(_SAMPLES)? events:' "$out_dir/perf-statistics.txt"; then
    echo "profile contains lost events; retain raw data and repeat" >&2
    exit 1
  fi
  perf script -i "$out_dir/perf.data" -F -period | inferno-collapse-perf | rustfilt >"$out_dir/profile.folded"
  jq -n --arg event "$event" \
    '{sample_unit: "samples", event: $event, lost_events: 0, period: (if $event == "cycles" then 100000 else null end), frequency: (if $event == "cpu-clock" then 997 else null end)}' \
    >"$out_dir/profile-metadata.json"
fi

inferno-flamegraph <"$out_dir/profile.folded" >"$out_dir/flamegraph.svg"

awk '{
  count = $NF
  sub(/ [0-9]+$/, "")
  n = split($0, frames, ";")
  self[frames[n]] += count
  total += count
}
END {
  for (frame in self)
    printf "%10d %6.2f%%  %s\n", self[frame], 100 * self[frame] / total, frame
}' "$out_dir/profile.folded" | sort -rn | awk 'NR <= 40' >"$out_dir/top_self.txt"

echo "== top self-time frames =="
cat "$out_dir/top_self.txt"
echo
echo "folded stacks: $out_dir/profile.folded"
echo "svg:           $out_dir/flamegraph.svg"
