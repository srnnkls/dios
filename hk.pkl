amends "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Config.pkl"

local rustGlob = List("src/**/*.rs", "benches/**/*.rs", "tests/**/*.rs", "Cargo.toml", "Cargo.lock")

local fast = new Mapping<String, Step> {
  ["fmt"] {
    glob = rustGlob
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["clippy"] {
    glob = rustGlob
    check = "cargo clippy --all-targets --features bench -- -D warnings"
  }
}

local heavy = new Mapping<String, Step> {
  ["test"] {
    glob = rustGlob
    check = "cargo test --features bench"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = true
    fail_on_fix = true
    // cargo checks read disk not index; stash's --include-untracked path corrupted the worktree.
    stash = "none"
    steps = new { ...fast }
  }
  ["check"] {
    steps = new {
      ...fast
      ...heavy
    }
  }
  ["post-checkout"] {
    env {
      ["MISE_CONFIG_DIR"] = "{{ root }}"
    }
    steps {
      ["worktreeinclude"] {
        check = "git worktreeinclude apply --quiet"
      }
    }
  }
  ["fix"] {
    fix = true
    steps {
      ["fmt"] = (fast["fmt"]) { check = null }
    }
  }
}
